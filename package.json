{
  "name": "hubzero-identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "npm run build:vercel-oidc && next build",
    "build:vercel-oidc": "tsx scripts/build-vercel-oidc.ts",
    "verify:vercel-native": "tsx scripts/verify-vercel-native-packages.ts",
    "verify:argon2-runtime": "tsx scripts/verify-argon2-runtime.ts",
    "verify:vercel-sign-in": "tsx scripts/verify-vercel-sign-in.ts",
    "vercel:rehearsal:configure": "tsx scripts/configure-vercel-rehearsal.ts",
    "vercel:rehearsal:canonical": "tsx scripts/run-vercel-canonical-rehearsal.ts",
    "verify:studio-identity-rehearsal": "tsx scripts/verify-studio-identity-rehearsal.ts",
    "verify:studio-identity-denials": "tsx scripts/verify-studio-identity-denials.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude 'test/e2e/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "db:indexes": "tsx scripts/apply-indexes.ts",
    "benchmark:password": "tsx scripts/benchmark-password.ts",
    "account:provision": "tsx scripts/provision-account.ts",
    "migration:studio:rehearse": "tsx scripts/rehearse-studio-migration.ts",
    "migration:studio:inventory": "tsx scripts/studio-production-inventory.ts",
    "migration:studio:execute": "tsx scripts/studio-migration-executor.ts",
    "application:studio:register:production": "tsx scripts/register-production-studio-client.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.6",
    "@vercel/functions": "^3.9.8",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "jose": "^6.2.12",
    "mongodb": "^6.19.0",
    "next": "^16.3.5",
    "oidc-provider": "^9.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tsx": "^4.20.6",
    "ulid": "^3.0.2",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.18.6",
    "@types/oidc-provider": "^9.12.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
