# Public origin of this Identity deployment. No trailing slash.
IDENTITY_ISSUER_URL=http://localhost:3000

# Dedicated HubZero Identity database; never point this at Studio's database.
# The URI must name a database explicitly. MONGODB_DATABASE is optional only when
# it matches that URI database; it exists as a deployment readability check.
MONGODB_URI=mongodb://127.0.0.1:27017/hubzero_identity_dev
MONGODB_DATABASE=hubzero_identity_dev

# At least 32 random bytes, encoded as base64. Used only to derive session
# lookup hashes; it is not the cookie value. Rotation requires the documented
# versioned migration procedure.
SESSION_HMAC_KEY_BASE64=

# A separate base64-encoded 32-byte key for privacy-preserving rate-limit keys.
RATE_LIMIT_HMAC_KEY_BASE64=

# Comma-separated trusted proxy addresses/CIDRs in hosted environments. Empty locally.
TRUSTED_PROXIES=

# Optional until recovery email is enabled in a later phase.
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=

# OIDC is deliberately disabled until an approved production initialization has
# registered clients and supplied secret-manager values. Enabling it in production
# requires all three OIDC values below.
OIDC_PROVIDER_ENABLED=false

# Never place signing private keys directly in source control. This must be a
# private ES256 JWK set from the deployment secret manager; public keys are served
# only through JWKS.
OIDC_SIGNING_KEYSET_JSON=

# Non-secret `kid` from that set used to sign new ID tokens. Retain previous
# public keys in the set during verification overlap.
OIDC_SIGNING_ACTIVE_KID=

# Separate HMAC key used only to derive provider-artifact database selectors.
OIDC_ADAPTER_HMAC_KEY_BASE64=

# JSON map of non-secret references in application records to client secrets.
# Do not store values in MongoDB or source control.
OIDC_CLIENT_SECRETS_JSON=

# Explicit environment name used by security policy and logging configuration.
APP_ENV=development
